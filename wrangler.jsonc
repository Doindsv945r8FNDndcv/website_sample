{
  // Deployed by Cloudflare Workers Builds on every push to main.
  "name": "johanwebsite",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Sender shown on contact-form emails; the domain must be verified in Resend.
    "MAIL_FROM": "Johan de Jong website <website@johandejong.eu>"
  }
  // Secrets, set in the Cloudflare dashboard (Worker > Settings > Variables and Secrets):
  //   RESEND_API_KEY  API key from resend.com
  //   CONTACT_TO      inbox that receives contact-form notes (kept off the site and out of git)
}
